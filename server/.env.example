# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local or Atlas)
# Local:  mongodb://127.0.0.1:27017/taskflow
# Atlas:  mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/taskflow

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Origin allowed to call this API. Comma separate to allow more than one.
CLIENT_URL=http://localhost:5173
