# This file is optional. Leave VITE_API_URL unset and the app does the right
# thing on its own:
#
#   npm run dev    ->  calls http://localhost:5000
#   npm run build  ->  calls /api on the same origin, which is what the single
#                      Render web service serves
#
# Set it only when the frontend is hosted separately from the API, for example
# a Render static site pointing at a Render web service:
#
# VITE_API_URL=https://taskflow-api.onrender.com
#
# Anything prefixed with VITE_ is compiled into the browser bundle and is public.
# Never put MONGODB_URI or JWT_SECRET in this file.
