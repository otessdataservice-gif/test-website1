# Copy to .env and fill in. Only put public values here: anything prefixed with
# VITE_ is compiled into the browser bundle and is visible to anyone.
# Never put MONGODB_URI or JWT_SECRET in this file.

# Base URL of the TaskFlow API.
# Local:  http://localhost:5000
# Render: https://taskflow-api.onrender.com
VITE_API_URL=http://localhost:5000
